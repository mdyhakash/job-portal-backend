model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade)

  // Personal
  profilePhoto String?
  bio          String?

  // Professional
  skills     String[]
  experience Int?
  education  String?

  // Resume
  resume             String?
  resumeOriginalName String?

  // Optional
  location  String?
  jobTitle  String?
  linkedin  String?
  github    String?
  portfolio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 @@map("profiles")
}